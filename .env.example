# Dell PowerEdge R730: 2x Xeon E5-2680 v4, 28 physical cores / 56 threads, ~116 GB RAM.
# Initial CPU-only profile; assumes enough CPU is allocated to this project.
# Targets below are not measured throughput guarantees; leave CPU for API/Postgres.
# scripts/setup.ps1 copies this template ONLY if .env does not already exist.

# Database (update password AND DATABASE_URL together before server deployment).
POSTGRES_DB=karhutla
POSTGRES_USER=karhutla
POSTGRES_PASSWORD=karhutla_local_demo
DATABASE_URL=postgresql+psycopg://karhutla:karhutla_local_demo@postgres:5432/karhutla
# setup.ps1 replaces this placeholder with a random token when creating .env.
SERVICE_TOKEN=replace-with-a-random-local-token

# Keep demo controls available for presentation. Existing DB speed is not reset.
DEMO_MODE=true
SIMULATION_SPEED=1

# Current Docker image installs CPU-only PyTorch. GPU needs a CUDA image plus
# GPU access in Compose; changing MODEL_DEVICE alone does not enable a GPU.
MODEL_PATH=/models/wildfire-smoke-fire.pt
MODEL_DEVICE=cpu
MODEL_IMAGE_SIZE=640
# Start with 12 inference threads, not all 56 logical threads.
# Compare 8 / 12 / 14 on the actual server before increasing further.
# Dual-socket locality and other school services affect the best setting.
TORCH_NUM_THREADS=12
OMP_NUM_THREADS=12
MKL_NUM_THREADS=12
OMP_WAIT_POLICY=PASSIVE
OPENCV_THREADS=1

# AI sampling target per channel (4 channels = up to 8 predictions/second).
# Keep this target until actual server timings are available.
# Predictions remain sequential in one vision worker. Do not scale vision or
# backend replicas: shared frame files and the singleton simulator require one.
INFERENCE_FPS=2
VISION_LOOP_INTERVAL=0.05
# MJPEG endpoint currently delivers at most 5 raw frames/s, 1 annotated frame/s.
# Raising this alone would increase JPEG writes without improving browser fps.
PREVIEW_FPS=5

# Preserve detection filtering; more server capacity does not establish accuracy.
# At 2 fps, 4 positives need roughly 1.5-2 s when processing keeps up.
CONFIDENCE_THRESHOLD=0.60
VALIDATION_WINDOW=6
VALIDATION_POSITIVES=4
DETECTION_COOLDOWN=60

# Browser-facing URLs, baked into the frontend at BUILD time.
# localhost works locally or via SSH port forwarding. For a public domain,
# configure reverse proxy, API CORS/Origin/TrustedHost and WebSocket Origin too:
# changing these two URLs alone is not a complete public-server deployment.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
